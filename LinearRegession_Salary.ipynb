        "    prediction = model(new_tensor)\n",
        "\n",
        "# trả về scale gốc\n",
        "salary_predict = y_scaler.inverse_transform(\n",
        "    prediction.numpy()\n",
        ")\n",
        "\n",
        "print(\"Predicted Salary:\", salary_predict[0][0])"
