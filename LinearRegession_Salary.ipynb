        "model.eval()\n",
        "\n",
        "new_data = np.array([[10.3]])\n",
        "\n",
        "# chuẩn hóa\n",
        "new_data_scaled = x_scaler.transform(new_data)\n",
        "\n",
        "# tensor\n",
        "new_tensor = torch.FloatTensor(new_data_scaled)\n",
        "\n",
